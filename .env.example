# Variables d'environnement — Proxi IT web

NEXT_PUBLIC_SITE_URL=https://www.proxi-it.fr
# Sur Vercel (démo ou prod) : définir l’URL publique exacte partagée (ex. https://proxit-it.vercel.app)
# pour que og:image, sitemap et JSON-LD pointent vers le bon domaine — pas l’URL de déploiement éphémère.

# ── Odoo CRM (recommandé — reproduit « Créer une opportunité ») ─────────────
# Utilisateur technique Odoo avec clé API (Paramètres > Compte > Clés API).
# ODOO_URL=https://votre-instance.odoo.com
# ODOO_DB=votre-base
# ODOO_LOGIN=integration@proxi-it.fr
# ODOO_API_KEY=

# Sujet de l'opportunité (équivalent champ « Sujet » du formulaire Odoo Website)
# ODOO_LEAD_SUBJECT=Nouveau contact site web

# Valeurs de secours si les paramètres Odoo ci-dessous ne sont pas encore créés :
# ODOO_CRM_TEAM_ID=     # ID équipe « Ventes »
# ODOO_CRM_USER_ID=     # ID vendeur (ex. Quentin BLONDEAU)

# ── Routage CRM éditable SANS redéployer le site ───────────────────────────
# Dans Odoo : Paramètres > Technique > Paramètres système
#   proxi_website.crm_team_id  → ID numérique de l'équipe commerciale
#   proxi_website.crm_user_id  → ID numérique du vendeur en charge
# Proxi IT peut changer équipe / vendeur ici (comme dans l'éditeur de formulaire).

# Webhook alternatif (n8n, controller custom) — utilisé seulement si Odoo API absent
# ODOO_WEBHOOK_URL=
# Secret partagé envoyé en header X-Webhook-Secret (optionnel, côté n8n à vérifier)
# ODOO_WEBHOOK_SECRET=

# ── E-mail de secours (SMTP OVH) — si Odoo API et webhook absents ───────────
# Compte mail OVH Proxi IT (ex. noreply@proxi-it.fr ou contact@proxi-it.fr).
# OVH : ssl0.ovh.net — port 587 (STARTTLS) ou 465 (SSL).
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@proxi-it.fr
# SMTP_PASS=
# SMTP_FROM=Proxi IT <noreply@proxi-it.fr>
# CONTACT_TO=contact@proxi-it.fr
# CONTACT_EMAIL_SUBJECT=[Site web] Nouveau contact

# Avis Google (Places API New — cache 24h)
# Sans clé : fallback statique (site.googleRating + googleReviewsFallback dans lib/site.ts)
# Avec clé : avis live sur la home + score/count mis à jour au build
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=   # Recommandé — évite une recherche texte à chaque build

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# ID de mesure GA4 (format G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Google Search Console ────────────────────────────────────────────────────
# Code de vérification (balise HTML) — sans les guillemets
# GOOGLE_SITE_VERIFICATION=

# Note : en développement (NODE_ENV !== production), le formulaire
# accepte les soumissions et logue la payload en console si Odoo n'est pas configuré.
